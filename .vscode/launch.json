{
  // Run and Debug configurations (F5). "type": "debugpy" is the Python Debugger.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CLI: quote the sample meal deal",
      "type": "debugpy",
      "request": "launch",
      "module": "novastack_orders",
      "args": ["quote", "data/samples/meal_deal_plus_drink.json", "--at", "2026-10-07T12:30"],
      "console": "integratedTerminal"
    },
    {
      "name": "CLI: list the menu",
      "type": "debugpy",
      "request": "launch",
      "module": "novastack_orders",
      "args": ["menu"],
      "console": "integratedTerminal"
    },
    {
      // Used by "Debug Test" in the Testing panel and editor gutter.
      "name": "Debug tests",
      "type": "debugpy",
      "request": "launch",
      "purpose": ["debug-test"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
